# Copy to .env.local and fill in what you have. Every key is optional:
# without one, that piece uses a local fallback and the demo still runs.
# .env.local is gitignored. Never commit real values.

# --- Texts ---
# Your iMessage phone number or Apple ID email, e.g. +14155550123. Without it, texts print to the console and the audit page.
IMESSAGE_TO=
# Link base inside texts. Default: your Mac's Wi-Fi address when IMESSAGE_TO is set, else localhost.
PUBLIC_BASE_URL=
# Audit page port.
PORT=4747

# --- Agent ---
# How often `npm run watch` checks orders, in seconds.
WATCH_INTERVAL_SEC=60
# Claims under this amount can be auto-approved when the flag is on.
AUTO_APPROVE_UNDER=5
# Fallback for the Statsig flag when STATSIG_SERVER_KEY is empty.
AUTO_APPROVE_SMALL_CLAIMS=true
# Delay between "Filed" and "Resolved" texts, in milliseconds.
RESOLVE_DELAY_MS=1500

# --- Drafting model (only writes text; rules decide the money) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Arcee Trinity via OpenRouter, used when ANTHROPIC_API_KEY is empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=arcee-ai/trinity-mini

# --- Analytics: Amplitude project API key ---
AMPLITUDE_API_KEY=

# --- Feature flag: Statsig server secret key and gate name ---
STATSIG_SERVER_KEY=
STATSIG_GATE=auto_approve_small_claims

# --- Rule book: Senso API key (starts with tgr_) ---
SENSO_API_KEY=
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1

# --- Clause ranking: Superlinked SIE ---
SUPERLINKED_API_KEY=
SUPERLINKED_BASE_URL=
SUPERLINKED_MODEL=BAAI/bge-reranker-v2-m3

# --- Household memory: Cognee Cloud ---
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_TENANT_ID=

# --- Merchant simulation: Firedrill (drills POST /firedrill) ---
FIREDRILL_API_KEY=
FIREDRILL_CLAIM_ID=

# --- Activity log: Guild AI (local log today; key reserved for sync) ---
GUILD_API_KEY=

# --- Merchant channel: simulated (default) or email (stub, throws) ---
MERCHANT_CHANNEL=simulated
